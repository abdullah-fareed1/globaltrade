    <artifactId>globaltrade-realm</artifactId>
    <packaging>jar</packaging>
    <name>GlobalTrade :: Realm</name>

    <!--
        Standalone jar, deliberately NOT depended on by globaltrade-ear.
        Ships to the Payara domain via the asadmin add-library command
        (type=common), once for this jar and once for jbcrypt-0.4.jar.
        See docs/payara-setup.asadmin (build plan Phase 5) for the exact
        commands.

        GlobalTradeRealm/GlobalTradeLoginModule extend Payara's
        AppservRealm / AppservPasswordLoginModule, which live in
        security.jar and security-ee.jar inside the payara glassfish
        modules directory. Those are NOT on Maven Central, so before
        compiling this module you must install them locally with
        "mvn install:install-file", pointing at each jar and giving it
        the groupId/artifactId/version used in the dependencies below
        (fish.payara:security and fish.payara:security-ee).

        Adjust payara.security.version if the coordinate you installed
        under does not match.
    -->

    <properties>
        <payara.security.version>6.0.0</payara.security.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

